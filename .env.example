# -----------------------------------------------------------------------------
# TrialBridge AI - Environment Configuration Example
# -----------------------------------------------------------------------------

# --- Infrastructure ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trialbridge"
REDIS_URL="redis://localhost:6379/0"
QDRANT_URL="http://localhost:6333"

# --- Object Storage (MinIO local / S3 production) ---
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"
S3_ENDPOINT_URL="http://localhost:9000"
S3_BUCKET_NAME="trialbridge-documents"

# --- Authentication ---
JWT_SECRET="super-secret-key-replace-in-production"

# --- AI Provider ---
# For development, you can use any supported LLM provider
LLM_API_KEY="your-llm-api-key"

# --- Frontend ---
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
